#!/bin/sh

customization() {
    # Set subnet and name
    true
}

# Unique part up to this line

append_if_exists() {
    [ -s "$1" ] && cat "$1" >>"$2"
    rm -f "$1"
}

maximize_wifi() {
    ucode -e '
import {readfile} from "fs";
import {cursor} from "uci";

let u = cursor();
let b = json(readfile("/etc/board.json"));

u.foreach("wireless", "wifi-device", (r) => {
    if (r.disabled == "1" || !r.path || !r.band || !r.htmode)
        return;

    let band = r.band == "2g" ? "2G" : r.band == "5g" ? "5G" : r.band == "6g" ? "6G" : null;
    if (!band)
        return;

    for (let name in b.wlan ?? {}) {
        let w = b.wlan[name];
        if (w.path != r.path && !(type(w.path) == "array" && index(w.path, r.path) >= 0))
            continue;

        let info = w.info?.bands?.[band];
        if (!info)
            return;

        let prefix = match(r.htmode, /^(EHT|HE|VHT|HT)/)?.[1];
        if (prefix) {
            for (let width in [320, 160, 80, 40, 20]) {
                let mode = prefix + width;
                if (index(info.modes ?? [], mode) >= 0) {
                    printf("set wireless.%s.htmode=%s\n", r[".name"], mode);
                    break;
                }
            }
        }

        let channel = info.default_channel;
        if (r.radio != null)
            for (let radio in w.info?.radios ?? [])
                if ("" + radio.index == "" + r.radio) {
                    channel = radio.bands?.[band]?.default_channel ?? channel;
                    break;
                }

        if (channel)
            printf("set wireless.%s.channel=%d\n", r[".name"], channel);

        return;
    }
});
' | uci -q batch
}

update_release_from_deploy_version() {
    [ -s /etc/deploy_version ] || return 0

    deploy_version="$(tr -d '\r\n' </etc/deploy_version)"

    sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='${deploy_version}'|" /etc/openwrt_release
    sed -i "s|^OPENWRT_RELEASE=.*|OPENWRT_RELEASE=\"${deploy_version}\"|" /etc/os-release
    sed -i "s|^OPENWRT_RELEASE=.*|OPENWRT_RELEASE=\"${deploy_version}\"|" /usr/lib/os-release
    sed -i "s|OpenWrt .*$|${deploy_version}|" /etc/banner

    rm -f /etc/deploy_version
}

setup_doh() {
    echo 'doh:x:4453:' >>/etc/group
    echo 'doh:x:4453:4453:doh:/var/run/doh:/bin/false' >>/etc/passwd

    uci -q set dhcp.@dnsmasq[0].noresolv='1'
    uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'
    uci -q del dhcp.@dnsmasq[0].server
    uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#5060'

    uci -q set https-dns-proxy.config.user='doh'
    uci -q set https-dns-proxy.config.group='doh'
}

# Append network
append_if_exists /etc/config/network_part /etc/config/network

# Append dhcp
append_if_exists /etc/config/dhcp_part /etc/config/dhcp

# Append firewall
append_if_exists /etc/config/firewall_part /etc/config/firewall

# Log size
uci -q set system.@system[0].log_size='10240'

# Set DOH
setup_doh

# Add timezone
uci -q set system.@system[0].timezone='MSK-3'
uci -q set system.@system[0].zonename='Europe/Moscow'

# Disable uhttpd HTTPS listener on port 443
uci -q delete uhttpd.main.listen_https

# Disable wan6 autostart
uci -q set network.wan6.auto='0'

# Do not send DHCP Client Identifier (Option 61)
uci -q set network.wan.sendclientid='none'

# Restart https-dns-proxy indefinitely if it keeps crashing
sed -i 's/procd_set_param respawn$/procd_set_param respawn 3600 30 0/' \
    /etc/init.d/https-dns-proxy

# Update release from deploy version
update_release_from_deploy_version

# Customization commands
customization

# Maximize enabled Wi-Fi radios
maximize_wifi

# Commit uci changes
uci commit

exit 0
