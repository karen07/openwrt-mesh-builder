#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
USE_PROCD=1
START=99

prog_name="exit-route.sh"
bin="/etc/scripts/$prog_name"

start_service() {
    procd_open_instance
    procd_set_param command "$bin"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "exit_route"
}

reload_service() {
    "$bin" once
}
